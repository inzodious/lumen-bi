model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["_Telemetry","Missions"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation Lumen_Template = orbital

ref table _Telemetry
ref table Missions
