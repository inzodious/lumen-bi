table _Desk
	lineageTag: 657b2b44-6aec-4cff-a376-406e4fce1716

	measure 'Weekday Riders (k)' = SUM(Ridership[RidersK])
		formatString: #,0
		lineageTag: f683ce96-b6c8-4094-a9fd-1f4d74f180b1

	measure 'Riders This Month' = CALCULATE(SUM(Ridership[RidersK]), Ridership[MonthNo] = MAX(Ridership[MonthNo]))
		formatString: #,0"k"
		lineageTag: ffbe9025-e24d-4a7d-a0e5-f4f93ef56e73

	measure 'On-Time %' = AVERAGE(Ridership[OnTime])
		formatString: 0.0%
		lineageTag: ca046036-c31a-4117-ae9f-50b729362795

	measure 'Fare Revenue' = SUM(Ridership[FareRevenueK]) / 1000
		formatString: \$#,0.0"M"
		lineageTag: c41b939b-3d15-475a-a01e-d3e3c637f394

	measure Complaints = SUM(Ridership[Complaints])
		formatString: #,0
		lineageTag: 3be5f480-b146-481e-a1f0-ac03f73a1d7b

	measure Growth = VAR m = MAX(Ridership[MonthNo]) VAR a = CALCULATE(SUM(Ridership[RidersK]), Ridership[MonthNo] = m) VAR b = CALCULATE(SUM(Ridership[RidersK]), Ridership[MonthNo] = 1) RETURN DIVIDE(a - b, b)
		formatString: +0%;-0%
		lineageTag: 11da44d1-bde3-4c1f-ad2f-ceb6efc68b45

	column Column1
		dataType: string
		isHidden
		lineageTag: 90104c56-38d4-4c90-aed3-e72f50ccb3a3
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Desk = m
		mode: import
		source =
				let
				    // sample data for the template: replace this query with your own source
				    Source = #table(type table [Column1 = text], {
				        {null}
				    })
				in
				    Source

	annotation PBI_ResultType = Table
