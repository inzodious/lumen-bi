	column week_month =
			
			VAR _DayOfMonth = DAY('dim_calendar'[date])
			RETURN
			    QUOTIENT(_DayOfMonth - 1, 7) + 1
		formatString: 0
		lineageTag: 3fa9e678-5d53-420f-9d12-3f823b70e4d8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column week_end = dim_calendar[date] + 7 - WEEKDAY(dim_calendar[date], 2)
		formatString: Short Date
		lineageTag: 297929be-32b7-4fe5-9665-0449d3932722
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_calendar = m
		mode: import
		queryGroup: Dimension
		source =
				let
				    // Calendar built in Power Query: edit the range or the fiscal year start here
				    FiscalYearStartMonth = 1,
				    Today = Date.From(DateTime.LocalNow()),
				    StartDate = #date(Date.Year(Today) - 3, 1, 1),
				    EndDate = Date.AddDays(Today, -1),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Source = Table.FromList(Dates, Splitter.SplitByNothing(), type table [date = date]),
				    #"Added Parts" = Table.AddColumn(Source, "parts", each
				        let
				            d = [date],
				            y = Date.Year(d),
				            m = Date.Month(d),
				            q = Date.QuarterOfYear(d),
				            dow = Date.DayOfWeek(d, Day.Monday) + 1,
				            fm = Number.Mod(m - FiscalYearStartMonth + 12, 12) + 1,
				            fy = if FiscalYearStartMonth > 1 and m >= FiscalYearStartMonth then y + 1 else y,
				            fq = Number.IntegerDivide(fm - 1, 3) + 1
				        in
				            [
				                date_key = y * 10000 + m * 100 + Date.Day(d),
				                year = y,
				                quarter = q,
				                month = m,
				                day = Date.Day(d),
				                month_name = Date.MonthName(d, "en-US"),
				                month_abbr = Text.Start(Date.MonthName(d, "en-US"), 3),
				                day_name = Date.DayOfWeekName(d, "en-US"),
				                day_abbr = Text.Start(Date.DayOfWeekName(d, "en-US"), 3),
				                year_month = Text.From(y) & "-" & Text.PadStart(Text.From(m), 2, "0"),
				                year_quarter = Text.From(y) & "-Q" & Text.From(q),
				                week_of_year = Date.WeekOfYear(d, Day.Monday),
				                day_of_week = dow,
				                day_of_year = Date.DayOfYear(d),
				                is_weekday = dow <= 5,
				                is_weekend = dow > 5,
				                is_future = d > Today,
				                fiscal_year = fy,
				                fiscal_quarter = fq,
				                fiscal_month = fm,
				                fiscal_year_period = "FY" & Text.From(fy) & "-P" & Text.PadStart(Text.From(fm), 2, "0"),
				                fiscal_year_quarter = "FY" & Text.From(fy) & "-Q" & Text.From(fq)
				            ]),
				    #"Expanded Parts" = Table.ExpandRecordColumn(#"Added Parts", "parts",
				        {"date_key", "year", "quarter", "month", "day", "month_name", "month_abbr", "day_name", "day_abbr", "year_month", "year_quarter", "week_of_year", "day_of_week", "day_of_year", "is_weekday", "is_weekend", "is_future", "fiscal_year", "fiscal_quarter", "fiscal_month", "fiscal_year_period", "fiscal_year_quarter"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded Parts", {
				        {"date", type date}, {"date_key", Int64.Type}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"day", Int64.Type},
				        {"month_name", type text}, {"month_abbr", type text}, {"day_name", type text}, {"day_abbr", type text}, {"year_month", type text}, {"year_quarter", type text},
				        {"week_of_year", Int64.Type}, {"day_of_week", Int64.Type}, {"day_of_year", Int64.Type},
				        {"is_weekday", type logical}, {"is_weekend", type logical}, {"is_future", type logical},
				        {"fiscal_year", Int64.Type}, {"fiscal_quarter", Int64.Type}, {"fiscal_month", Int64.Type}, {"fiscal_year_period", type text}, {"fiscal_year_quarter", type text}}),
				    #"Sorted Rows" = Table.Sort(#"Changed Type", {{"date", Order.Descending}}),
				    #"Added Index" = Table.AddIndexColumn(#"Sorted Rows", "sort_desc", 1, 1, Int64.Type)
				in
				    #"Added Index"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

