table _Trail
	lineageTag: c151e999-5673-46b0-a703-f4c782690235

	measure Visitors = SUM(Visits[Visitors])
		formatString: #,0
		lineageTag: 84de97be-bbb1-4b13-a081-e1cd6674a276

	measure 'Trail km Maintained' = SUM(Visits[TrailKm])
		formatString: #,0" km"
		lineageTag: 64e1306e-839b-428c-a2ad-8a620cd4ccfa

	measure 'Trees Planted' = SUM(Visits[TreesPlanted])
		formatString: #,0
		lineageTag: f0f2edd0-4551-422f-ab39-30b089b5f64e

	measure 'Wildlife Sightings' = SUM(Sightings[Sightings])
		formatString: #,0
		lineageTag: 783e8795-06e0-4652-a742-4648d6e3ca74

	measure 'Busiest Park' = FIRSTNONBLANK(TOPN(1, VALUES(Parks[Park]), [Visitors]), 1)
		lineageTag: beb32931-a923-439e-af2d-b7e5b6afe059

	measure 'Visitors Note' = "busiest: " & [Busiest Park]
		lineageTag: d19d52bf-b6bd-492c-a6e2-890d21d481fa

	measure 'Trail Note' = "cleared, graded and signed"
		lineageTag: 59fb8c93-c79c-409d-a014-44083a1228fc

	measure 'Trees Note' = "by volunteers this season"
		lineageTag: b2069f6f-580d-4f12-a765-fcea1fd29e1d

	measure 'Sightings Note' = DISTINCTCOUNT(Sightings[Species]) & " species logged"
		lineageTag: a68b9ee0-5dfb-467b-a38b-62f1dbbae782

	column Column1
		dataType: string
		isHidden
		lineageTag: e3335721-6200-45cf-abfb-b2b703ddd0aa
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Trail = m
		mode: import
		source =
				let
				    // sample data for the template: replace this query with your own source
				    Source = #table(type table [Column1 = text], {
				        {null}
				    })
				in
				    Source

	annotation PBI_ResultType = Table
