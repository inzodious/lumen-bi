model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["_OEE","Production","Downtime"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation Lumen_Template = blueprint

ref table _OEE
ref table Production
ref table Downtime
