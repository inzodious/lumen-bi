model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Measures

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimension

	annotation PBI_QueryGroupOrder = 1

queryGroup Fact

	annotation PBI_QueryGroupOrder = 2

annotation PBI_QueryOrder = ["_measures_kpi","_measures_format","dim_calendar","dim_mission","dim_ground_station","fact_launch","fact_telemetry","fact_anomaly","fact_ground_pass"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table _measures_kpi
ref table _measures_format
ref table dim_calendar
ref table dim_mission
ref table dim_ground_station
ref table fact_launch
ref table fact_telemetry
ref table fact_anomaly
ref table fact_ground_pass
