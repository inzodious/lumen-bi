{
  "name": "lumen-bi",
  "productName": "Lumen",
  "version": "0.1.0",
  "description": "A Linux-native Power BI report & semantic model workbench: open PBIX / PBIP (PBIR + TMDL), DAX engine, Power Query engine, modeling, rich export.",
  "main": "./out/main/index.js",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --linux AppImage deb",
    "dist:win": "electron-vite build && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@fluentui/react-icons": "^2.0.346",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.2",
    "codemirror": "^6.0.2",
    "d3": "^7.9.2",
    "dompurify": "^3.4.18",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hyparquet": "^1.33.1",
    "hyparquet-writer": "^0.18.0",
    "immer": "^11.2.10",
    "nanoid": "^6.0.2",
    "playwright-core": "^1.65.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "topojson-client": "^3.1.0",
    "typescript": "5.9",
    "us-atlas": "^3.0.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@azure/identity": "^4.14.1",
    "google-auth-library": "^11.3.4",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sql.js": "^1.16.0",
    "tedious": "^20.3.9"
  },
  "build": {
    "appId": "dev.lumen.app",
    "productName": "Lumen",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [],
    "fileAssociations": [
      {
        "ext": "pbix",
        "name": "Power BI Desktop file",
        "mimeType": "application/vnd.ms-powerbi.pbix",
        "role": "Editor"
      },
      {
        "ext": "pbit",
        "name": "Power BI template",
        "role": "Editor"
      },
      {
        "ext": "pbip",
        "name": "Power BI project",
        "role": "Editor"
      },
      {
        "ext": "wbi",
        "name": "Lumen bundle",
        "mimeType": "application/x-lumen-bundle",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "executableName": "lumen",
      "synopsis": "Power BI reports and semantic models on Linux",
      "desktop": {
        "entry": {
          "StartupWMClass": "Lumen"
        }
      }
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png",
      "executableName": "Lumen"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lumen",
      "artifactName": "Lumen-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Lumen-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "**/*.wasm"
    ]
  }
}
