model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Measures

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimension

	annotation PBI_QueryGroupOrder = 1

queryGroup Fact

	annotation PBI_QueryGroupOrder = 2

annotation PBI_QueryOrder = ["_measures_kpi","_measures_format","dim_calendar","dim_track","dim_country","fact_stream","fact_audience"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table _measures_kpi
ref table _measures_format
ref table dim_calendar
ref table dim_track
ref table dim_country
ref table fact_stream
ref table fact_audience
