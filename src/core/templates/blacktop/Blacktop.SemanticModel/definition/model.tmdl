model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["_Stats","Games"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation Lumen_Template = blacktop

ref table _Stats
ref table Games
