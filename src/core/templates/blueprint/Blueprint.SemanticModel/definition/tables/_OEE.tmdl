table _OEE
	lineageTag: e7370572-e659-42ca-a86a-1d98af3bf30a

	measure Availability = DIVIDE(SUM(Production[RunMin]), SUM(Production[PlannedMin]))
		formatString: 0.0%
		lineageTag: 8a9ea80d-7720-48ec-a9dd-98df2e1cb379

	measure Performance = DIVIDE(SUM(Production[ActualUnits]), SUM(Production[IdealUnits]))
		formatString: 0.0%
		lineageTag: 67feb518-460c-45b5-a126-5f4d38ac9266

	measure Quality = DIVIDE(SUM(Production[GoodUnits]), SUM(Production[ActualUnits]))
		formatString: 0.0%
		lineageTag: e4272b6c-df0c-4bde-a23a-538781240f3e

	measure OEE = [Availability] * [Performance] * [Quality]
		formatString: 0.0%
		lineageTag: c6cbd0d6-060b-4131-a7d6-82d87cd47595

	measure 'OEE Target' = 0.85
		formatString: 0%
		lineageTag: 95c728cc-0818-4cc6-a6cc-b8d41448f9b7

	measure 'Good Units' = SUM(Production[GoodUnits])
		formatString: #,0
		lineageTag: a2436521-9171-4587-a536-87e068925274

	measure 'Scrap Rate' = 1 - [Quality]
		formatString: 0.00%
		lineageTag: c77a046d-bca5-4edf-a9e5-1e1bd9af50d4

	measure 'Downtime (h)' = SUM(Downtime[Minutes]) / 60
		formatString: #,0
		lineageTag: aa458be8-4a43-42f5-a3a8-5051daf5dade

	measure 'OEE Note' = IF([OEE] >= [OEE Target], "AT OR ABOVE 85% TARGET", "GAP TO TARGET " & FORMAT([OEE Target] - [OEE], "0.0%"))
		lineageTag: 69e61e39-f6a3-4254-a4bd-94a6e187e93a

	column Column1
		dataType: string
		isHidden
		lineageTag: 2e79032a-9fa6-410d-a228-5321e1c0d31e
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _OEE = m
		mode: import
		source =
				let
				    // sample data for the template: replace this query with your own source
				    Source = #table(type table [Column1 = text], {
				        {null}
				    })
				in
				    Source

	annotation PBI_ResultType = Table
