model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["_Desk","Ridership"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation Lumen_Template = broadsheet

ref table _Desk
ref table Ridership
