table _Ledger
	lineageTag: 09b8ae98-624f-43c2-a80e-bdc186156900

	measure 'Records Sold' = SUM(Sales[Units])
		formatString: #,0
		lineageTag: 566b6ae5-2ccd-4015-acfb-6c6b81eb0143

	measure Revenue = SUM(Sales[Revenue])
		formatString: \$#,0
		lineageTag: 85823184-45ef-4143-a131-7f03ef2c83c5

	measure 'Avg Ticket' = DIVIDE([Revenue], [Records Sold])
		formatString: \$0.00
		lineageTag: d29f9713-fea4-4279-a76f-90a092672081

	measure 'Top Genre' = FIRSTNONBLANK(TOPN(1, VALUES(Sales[Genre]), [Records Sold]), 1)
		lineageTag: cd9cd1a0-0414-4575-a33b-924b07fd99ef

	measure 'Singles Share' = DIVIDE(CALCULATE([Records Sold], Sales[Format] = "45 Single"), [Records Sold])
		formatString: 0%
		lineageTag: 841b594b-4e13-472e-a61b-c15ba62057bf

	measure 'Sold Note' = "spinning out of the shop, led by " & [Top Genre]
		lineageTag: 7b7094a5-116f-41da-ad43-33378b2f5c4a

	measure 'Revenue Note' = "at " & FORMAT([Avg Ticket], "\$0.00") & " a record, on average"
		lineageTag: ec9084b4-581f-42ea-a5ce-f0efbe13ca5a

	measure 'Singles Note' = "of everything sold was a 45"
		lineageTag: 4cceff0f-1038-468a-a23f-7600c9bbaca5

	column Column1
		dataType: string
		isHidden
		lineageTag: a7dcc404-16a4-41a5-a429-e5d2acb412ea
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Ledger = m
		mode: import
		source =
				let
				    // sample data for the template: replace this query with your own source
				    Source = #table(type table [Column1 = text], {
				        {null}
				    })
				in
				    Source

	annotation PBI_ResultType = Table
