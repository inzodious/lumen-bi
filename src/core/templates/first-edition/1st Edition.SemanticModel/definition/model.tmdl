model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Measures

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimension

	annotation PBI_QueryGroupOrder = 1

annotation PBI_QueryOrder = ["_measures_kpi","_measures_format","_measures_time","dim_last_refresh","dim_calendar"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table _measures_kpi
ref table _measures_format
ref table _measures_time
ref table dim_last_refresh
ref table dim_calendar

