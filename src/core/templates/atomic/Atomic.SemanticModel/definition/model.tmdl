model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["_Ledger","Sales"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation Lumen_Template = atomic

ref table _Ledger
ref table Sales
