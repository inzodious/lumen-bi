model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Measures

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimension

	annotation PBI_QueryGroupOrder = 1

queryGroup Fact

	annotation PBI_QueryGroupOrder = 2

annotation PBI_QueryOrder = ["_measures_kpi","_measures_format","dim_calendar","dim_location","dim_material","dim_event_type","dim_customer","fact_extraction","fact_downtime","fact_shipment","fact_sales","fact_inventory"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table _measures_kpi
ref table _measures_format
ref table dim_calendar
ref table dim_location
ref table dim_material
ref table dim_event_type
ref table dim_customer
ref table fact_extraction
ref table fact_downtime
ref table fact_shipment
ref table fact_sales
ref table fact_inventory
