table _Telemetry
	lineageTag: c8334479-c5c2-466c-ad6a-317128c55f91

	measure Launches = SUM(Missions[Launches])
		formatString: #,0
		lineageTag: e15a7c5a-0bbe-489e-a0a2-9dc0f22cc9bd

	measure 'Payload (t)' = SUM(Missions[PayloadKg]) / 1000
		formatString: #,0.0" t"
		lineageTag: 86d0c4b0-5698-4096-a6ae-1ae450922eab

	measure Uptime = AVERAGE(Missions[Uptime])
		formatString: 0.00%
		lineageTag: f36adccc-227e-4458-a9fe-43c6da318e15

	measure 'Data Downlinked' = SUM(Missions[DataTB])
		formatString: #,0" TB"
		lineageTag: 928ec4c0-4e4f-48d4-a3fd-402384b2fe2c

	measure Anomalies = SUM(Missions[Anomalies])
		formatString: #,0
		lineageTag: 376a56c1-d029-400e-a99a-bc5b868b4fef

	measure 'Anomaly Rate' = DIVIDE([Anomalies], [Launches])
		formatString: 0.0%
		lineageTag: 32eb8ec5-f70f-4012-a64c-b4217bb24ee9

	measure 'Active Missions' = DISTINCTCOUNT(Missions[Mission])
		formatString: 0
		lineageTag: a8ddbcc7-5ecd-4a26-ac1c-d51c8bc42e72

	measure 'Launch Note' = "across " & [Active Missions] & " active missions"
		lineageTag: 34f336cf-9d04-4650-aa07-d867290cf731

	measure 'Data Note' = FORMAT(DIVIDE([Data Downlinked], 12), "#,0") & " TB per month on average"
		lineageTag: 64fec157-e41c-4389-afb9-e2bed127b6da

	measure 'Payload Note' = FORMAT(DIVIDE(SUM(Missions[PayloadKg]), [Launches]), "#,0") & " kg per launch"
		lineageTag: 017a4d2b-204e-4714-a742-3c36220a1752

	measure 'Uptime Note' = [Anomalies] & " anomalies logged  ·  " & FORMAT([Anomaly Rate], "0.0%") & " of launches"
		lineageTag: 8db4b9b6-0c3d-4ca6-af2a-2464c69e3ac5

	column Column1
		dataType: string
		isHidden
		lineageTag: 6cd8e7c8-f3e2-4c8e-aabb-2d8a84d60816
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Telemetry = m
		mode: import
		source =
				let
				    // sample data for the template: replace this query with your own source
				    Source = #table(type table [Column1 = text], {
				        {null}
				    })
				in
				    Source

	annotation PBI_ResultType = Table
